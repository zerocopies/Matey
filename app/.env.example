# Local LAN backend for on-device testing.
# Your machine's IP; the backend must be started with:
#   uvicorn main:app --host 0.0.0.0 --port 8001
# The URL must include the /api/v1 prefix.
#
# For production, replace with a public URL or tunnel (ngrok/Pinggy), e.g.
#   VITE_API_BASE_URL=https://ai-concierge-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://YOUR_LOCAL_IP:8001/api/v1
